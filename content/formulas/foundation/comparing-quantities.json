[
  {
    "id": "found.math.8.cq.percent-of",
    "name": "Percentage of a Quantity",
    "latex": "\\text{Percent of } N = \\frac{P}{100} \\times N",
    "vars": { "P": "percentage value", "N": "base quantity" },
    "example": "20% of 350 = (20/100) x 350 = 70"
  },
  {
    "id": "found.math.8.cq.percent-change",
    "name": "Percentage Increase or Decrease",
    "latex": "\\text{Percent Change} = \\frac{|\\text{New} - \\text{Original}|}{\\text{Original}} \\times 100",
    "vars": { "New": "new value", "Original": "original value" },
    "example": "Price rises from 200 to 250: change = (50/200) x 100 = 25%"
  },
  {
    "id": "found.math.8.cq.profit-loss",
    "name": "Profit and Loss Percentage",
    "latex": "\\text{Profit/Loss \\%} = \\frac{SP - CP}{CP} \\times 100",
    "vars": { "SP": "selling price", "CP": "cost price" },
    "example": "CP = 800, SP = 920: profit% = (120/800) x 100 = 15%"
  },
  {
    "id": "found.math.8.cq.discount",
    "name": "Discount and Selling Price",
    "latex": "\\text{Discount} = \\frac{D\\%}{100} \\times MP, \\quad SP = MP - \\text{Discount}",
    "vars": { "D%": "discount percent", "MP": "marked price", "SP": "selling price" },
    "example": "MP = 600 at 15% discount: discount = 90, SP = 600 - 90 = Rs 510"
  },
  {
    "id": "found.math.8.cq.simple-interest",
    "name": "Simple Interest",
    "latex": "SI = \\frac{P \\times R \\times T}{100}",
    "vars": { "P": "principal", "R": "annual rate percent", "T": "time in years" },
    "example": "P = 5000, R = 8%, T = 2 years: SI = (5000 x 8 x 2)/100 = Rs 800"
  },
  {
    "id": "found.math.8.cq.compound-interest",
    "name": "Compound Interest (Amount)",
    "latex": "A = P \\left(1 + \\frac{R}{100}\\right)^T, \\quad CI = A - P",
    "vars": { "P": "principal", "R": "annual rate percent", "T": "time in years", "A": "amount after interest" },
    "example": "P = 10000, R = 10%, T = 2 years: A = 12100, CI = Rs 2100"
  }
]
