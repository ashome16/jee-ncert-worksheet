    "name": "Profit and Loss Percentage",
    "latex": "\\text{Profit/Loss \\%} = \\frac{SP - CP}{CP} \\times 100",
    "vars": { "SP": "selling price", "CP": "cost price" }
  },
  {
    "id": "found.math.8.cq.simple-interest",
    "name": "Simple Interest",
    "latex": "SI = \\frac{P \\times R \\times T}{100}",
    "vars": { "P": "principal", "R": "annual rate percent", "T": "time in years" }
  },
  {
